# Example nginx for alexandraaleksiuk.com (Ubuntu).
# Install: symlink into sites-enabled, then `nginx -t && systemctl reload nginx`.
#
# CRITICAL: never use $host or $server_name with port 3000 in public redirects.
# Always redirect www and apex to https://alexandraaleksiuk.com without a port.

server {
    listen 80;
    listen [::]:80;
    server_name alexandraaleksiuk.com www.alexandraaleksiuk.com;
    return 301 https://alexandraaleksiuk.com$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.alexandraaleksiuk.com;

    # ssl_certificate ...

    return 301 https://alexandraaleksiuk.com$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name alexandraaleksiuk.com;

    # ssl_certificate ...

    # Optional: single hop for bare / (middleware also redirects to /uk)
    location = / {
        return 301 https://alexandraaleksiuk.com/uk;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Do NOT set X-Forwarded-Host to a host:port unless clients must see it
        proxy_set_header X-Forwarded-Host $host;
    }
}
